# Multi-stage Dockerfile for AuraVoice Go Backend API
FROM golang:1.23-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git build-base

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" -o /app/auravoice-api cmd/server/main.go

# Production runtime stage
FROM alpine:3.19

WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /app/auravoice-api /app/auravoice-api
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080
ENV PORT=8080
ENV ENV=production

CMD ["/app/auravoice-api"]
