# ==============================================================================
# AuraVoice Backend Server Configuration
# ==============================================================================

# Server Network Port & Environment
PORT=8080
ENV=development

# Database Configuration (Embedded SQLite by default; or postgresql://user:pass@host:5432/db)
DATABASE_URL=auravoice.db

# Redis Configuration (Optional; in-memory fallback enabled if unconfigured)
REDIS_URL=redis://localhost:6379/0

# Cryptographic Authentication Secrets (Replace with 64-char random strings in production)
JWT_SECRET=aura_voice_super_secure_jwt_secret_key_2026
ADMIN_API_KEY=aura_admin_master_secret_key_2026

# WebRTC STUN Signaling
STUN_SERVER_URL=stun:stun.l.google.com:19302

# CORS Whitelist (Comma-separated origins for web access)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payments & Webhooks
PAYMENT_WEBHOOK_SECRET=whsec_aura_payment_secret_2026

# Security Limits
UPLOAD_MAX_BYTES=2097152
RATE_LIMIT_PER_MIN=120

# Optional SFU / LiveKit Settings (Only needed if clustering large multi-speaker stages)
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_aura_voice_dev
